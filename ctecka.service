[Unit]
Description=E-ink čtečka EPUB (autostart po zapnutí)
# Až je systém plně nahraný a souborový systém připravený. Čtečka nepotřebuje
# síť, takže se na ni nečeká.
After=multi-user.target

[Service]
Type=simple
# Placeholdery vyplní install-sluzba.sh podle skutečného uživatele a cesty.
User=__UZIVATEL__
WorkingDirectory=__ADRESAR__
ExecStart=__ADRESAR__/.venv/bin/python __ADRESAR__/hlavni_ctecka.py
# Po pádu (nenulový návrat) čtečku nastartuj znovu. Vypnutí po hodině nečinnosti
# končí návratem 0 a to se nerestartuje — jinak by se čtečka po `sudo poweroff`
# nastartovala ještě jednou, než systém stihne spadnout.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
